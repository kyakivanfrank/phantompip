# ============================================================================
# PHANTOMPIP ENVIRONMENT TEMPLATE (.env.example)
# Duplicate this file as .env.local for local development, or set in Vercel.
# ============================================================================

NODE_ENV="development"

# ============================================================================
# PRIMARY DATABASE (Supabase Postgres)
# Get these from your Supabase Project Settings -> API
# ============================================================================
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_service_role_key"

# ============================================================================
# BACKUP DATABASE (Supabase Postgres Redundancy)
# Auto-mirrored in real-time. Automated failover occurs if primary is unreachable.
# ============================================================================
BACKUP_SUPABASE_URL="https://your-backup-project-id.supabase.co"
BACKUP_SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_backup_service_role_key"

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="your-32-byte-base64-encryption-key"

# Session cookie JWT signing & expiration (in seconds: 86400 = 24 hours)
SESSION_SECRET="your-secure-session-secret-key-at-least-32-chars"
SESSION_EXPIRY="86400"

# ============================================================================
# ADMIN INITIALIZATION
# ============================================================================
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_PLAIN="YourSecureAdminPassword123!"
ENABLE_ADMIN_INIT="true"
CREATE_ADMIN_BY_RUNNING_THIS="curl -X POST http://localhost:3000/api/admin/init"

# ============================================================================
# PAYMENT CONFIGURATION (Crypto & Activation)
# Note: Platform settings are also dynamically editable in Admin -> Settings
# ============================================================================
ACTIVATION_FEE="99"
CRYPTO_BTC_ADDRESS="your-btc-wallet-address"
CRYPTO_BEP20_ADDRESS="your-bep20-wallet-address"
CRYPTO_ERC20_ADDRESS="your-erc20-wallet-address"
